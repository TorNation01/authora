# =============================================================================
# AUTHORA Development Environment
# Copy to .env for local development. Safe defaults for Docker dev stack.
# =============================================================================

DEPLOYMENT_MODE=standalone

# Database - Docker compose default
DATABASE_URL=postgresql://authora:authora@localhost:5432/authora
REDIS_URL=redis://localhost:6379/0

# Auth - dev only; change for any shared environment
SECRET_KEY=dev-secret-change-in-production

# Frontend - same-origin for dev
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEPLOYMENT_MODE=standalone
API_URL=

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Telemetry
TELEMETRY_ENABLED=false
