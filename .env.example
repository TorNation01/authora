# =============================================================================
# AUTHORA Environment Configuration
# Copy to .env and configure. Never commit .env to version control.
# See docs/ENV-MAP.md for full reference.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# standalone | anakatech | white_label
DEPLOYMENT_MODE=standalone
# Optional: overrides DEPLOYMENT_MODE when set
# APP_MODE=standalone

# -----------------------------------------------------------------------------
# Anakatech Integration (only when DEPLOYMENT_MODE=anakatech or white_label)
# -----------------------------------------------------------------------------
# ENABLE_SSO=false
# ENABLE_SHARED_NAV=false
# ENABLE_SHARED_NOTIFICATIONS=false
# ENABLE_SHARED_ANALYTICS=false
# ENABLE_SHARED_BILLING=false
# ENABLE_BRAND_OVERRIDES=true

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local/Docker dev: localhost. Production Docker: use postgres as host.
# Example prod: postgresql://authora:YOUR_PASSWORD@postgres:5432/authora
DATABASE_URL=postgresql://authora:authora@localhost:5432/authora

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------
# Local/Docker dev: localhost. Production Docker: use redis as host.
# Example prod: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Auth (required - change in production!)
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Cron secret for /accountability/cron/reminders (production: set to protect endpoint)
# Generate: openssl rand -hex 32
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Frontend (required for production)
# -----------------------------------------------------------------------------
# Public URL where the API is reachable. Leave empty for same-origin (dev).
# Production: https://api.authora.studio
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEPLOYMENT_MODE=standalone
# Production (authora.studio structure) - uncomment for deploy:
# NEXT_PUBLIC_MARKETING_URL=https://authora.studio
# NEXT_PUBLIC_APP_URL=https://app.authora.studio

# Server-side API URL for Next.js API routes (e.g. Docker: http://api:8000)
# Falls back to NEXT_PUBLIC_API_URL if unset
API_URL=

# -----------------------------------------------------------------------------
# AI (optional - enables AI features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
AI_PROVIDER_MODE=auto
AI_MODEL=gpt-4o-mini

# AI provider toggles
# AI_CLOUD_DISABLED=false
# AI_LOCAL_ONLY=false

# AI timeouts (seconds) and retries
# AI_OPENAI_TIMEOUT=60
# AI_ANTHROPIC_TIMEOUT=60
# AI_OLLAMA_TIMEOUT=120
# AI_RETRY_COUNT=3
# AI_FALLBACK_ENABLED=true

# Model allowlists (comma-separated; empty = allow all)
# AI_OPENAI_MODELS_ALLOWLIST=
# AI_ANTHROPIC_MODELS_ALLOWLIST=

# Ollama (local/self-hosted - no API key required)
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_DEFAULT=llama3.2
# OLLAMA_REQUEST_TIMEOUT=120
# OLLAMA_HARDWARE_TIER=
# OLLAMA_MODEL_QUICK_ASSIST=
# OLLAMA_MODEL_DEFAULT_WRITING=
# OLLAMA_MODEL_PREMIUM_DRAFTING=
# OLLAMA_MODEL_FICTION_IDEATION=
# OLLAMA_MODEL_NONFICTION_STRUCTURE=
# OLLAMA_MODEL_EDITING_POLISH=
# OLLAMA_MODEL_SUMMARIZATION=
# OLLAMA_MODEL_EMBEDDINGS=
# OLLAMA_MODEL_OPTIONAL_VISION=

# Embeddings (RAG / semantic search)
# EMBEDDINGS_ENABLED=false
# EMBEDDINGS_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_BASE_URL=
# RAG_MAX_CHUNKS=5
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100

# -----------------------------------------------------------------------------
# CORS (comma-separated or JSON array)
# -----------------------------------------------------------------------------
# Dev: localhost. Production: include marketing + app origins for api.authora.studio
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Production (Option 2): CORS_ORIGINS=["https://authora.studio","https://www.authora.studio","https://app.authora.studio"]

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# -----------------------------------------------------------------------------
# Telemetry (optional)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# Production domains (for Caddy - run ./scripts/generate-caddyfile.sh)
# -----------------------------------------------------------------------------
# Option 2: authora.studio=marketing, app.authora.studio=app, api.authora.studio=API
# DOMAIN_API=api.authora.studio
# DOMAIN_MARKETING=authora.studio
# DOMAIN_APP=app.authora.studio
# ACME_EMAIL=admin@authora.studio

# -----------------------------------------------------------------------------
# Cron (optional - protects /accountability/cron/reminders)
# -----------------------------------------------------------------------------
# CRON_SECRET=  # openssl rand -hex 32
