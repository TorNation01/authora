# =============================================================================
# AUTHORA Environment Configuration
# Copy to .env and configure. Never commit .env to version control.
# See docs/ENV-MAP.md for full reference.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# standalone | anakatech | white_label
DEPLOYMENT_MODE=standalone
# Optional: overrides DEPLOYMENT_MODE when set
# APP_MODE=standalone

# -----------------------------------------------------------------------------
# Anakatech Integration (only when DEPLOYMENT_MODE=anakatech or white_label)
# -----------------------------------------------------------------------------
# ENABLE_SSO=false
# ENABLE_SHARED_NAV=false
# ENABLE_SHARED_NOTIFICATIONS=false
# ENABLE_SHARED_ANALYTICS=false
# ENABLE_SHARED_BILLING=false
# ENABLE_BRAND_OVERRIDES=true

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local/Docker dev: localhost. Production Docker: use postgres as host.
# Example prod: postgresql://authora:YOUR_PASSWORD@postgres:5432/authora
DATABASE_URL=postgresql://authora:authora@localhost:5432/authora

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------
# Local/Docker dev: localhost. Production Docker: use redis as host.
# Example prod: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Auth (required - change in production!)
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Cron secret for /accountability/cron/reminders (production: set to protect endpoint)
# Generate: openssl rand -hex 32
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Frontend (required for production)
# -----------------------------------------------------------------------------
# Public URL where the API is reachable (e.g. https://api.yourdomain.com)
# Leave empty for same-origin (dev). In Docker, set for browser + server-side fetch.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEPLOYMENT_MODE=standalone
# Optional: NEXT_PUBLIC_APP_MODE=standalone (fallback when API unavailable)

# Server-side API URL for Next.js API routes (e.g. Docker: http://api:8000)
# Falls back to NEXT_PUBLIC_API_URL if unset
API_URL=

# -----------------------------------------------------------------------------
# AI (optional - enables AI features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_PROVIDER_MODE=auto
AI_MODEL=gpt-4o-mini

# Ollama (local/self-hosted - no API key required)
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_DEFAULT=llama3.2
# OLLAMA_MODEL_WRITING_ASSIST=
# OLLAMA_MODEL_FICTION_IDEATION=
# OLLAMA_MODEL_NONFICTION_STRUCTURE=
# OLLAMA_MODEL_GHOSTWRITING=
# OLLAMA_MODEL_EDITING_POLISH=

# -----------------------------------------------------------------------------
# CORS (comma-separated or JSON array)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# -----------------------------------------------------------------------------
# Telemetry (optional)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# Production domains (for Caddy - run ./scripts/generate-caddyfile.sh)
# -----------------------------------------------------------------------------
# DOMAIN_API=api.yourdomain.com
# DOMAIN_WEB=app.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# Cron (optional - protects /accountability/cron/reminders)
# -----------------------------------------------------------------------------
# CRON_SECRET=  # openssl rand -hex 32
