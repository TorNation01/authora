'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';

interface NavProps {
  projectId: string;
  bookId: string;
}

const bookBase = (projectId: string, bookId: string) =>
  `/dashboard/projects/${projectId}/books/${bookId}`;

const BOOK_LINKS = [
  { key: 'idea', label: 'Book Idea' },
  { key: 'bible', label: 'Bible' },
  { key: 'outline', label: 'Outline' },
  { key: 'plan', label: 'Plan' },
  { key: 'brief', label: 'Chapter Briefs' },
  { key: 'acts', label: 'Acts' },
  { key: 'ghostwriter', label: 'Ghostwriter' },
  { key: 'edit', label: 'Edit & Polish' },
];

const BIBLE_LINKS = [
  { key: '', label: 'Overview' },
  { key: '?section=story_foundation', label: 'Story' },
  { key: '?section=narrative_format', label: 'Format' },
  { key: '?section=tone_and_voice', label: 'Voice' },
  { key: '?section=world_and_setting', label: 'World' },
  { key: '?section=characters', label: 'Characters' },
  { key: '?section=structure', label: 'Structure' },
  { key: '?section=canon_status', label: 'Canon' },
];

/**
 * Book-level nav. Rendered on every Bible page and on the plan, ghostwriter
 * and edit surfaces, so the Bible is one click away from wherever the writer is.
 */
export function BookNav({ projectId, bookId, className = '' }: NavProps & { className?: string }) {
  const pathname = usePathname() || '';
  const base = bookBase(projectId, bookId);

  return (
    <nav
      aria-label="Book sections"
      className={`flex items-center gap-6 overflow-x-auto border-b border-border ${className}`}
    >
      {BOOK_LINKS.map((link) => {
        const href = `${base}/${link.key}`;
        const active =
          link.key === 'bible'
            ? pathname.includes(`${base}/bible`)
            : pathname.startsWith(href);
        return (
          <Link
            key={link.key}
            href={href}
            aria-current={active ? 'page' : undefined}
            className={`-mb-px whitespace-nowrap border-b-2 pb-2 pt-1 text-sm transition-colors ${
              active
                ? 'border-primary font-medium text-foreground'
                : 'border-transparent text-muted-foreground hover:text-foreground'
            }`}
          >
            {link.label}
          </Link>
        );
      })}
    </nav>
  );
}

/** Section nav inside the Bible. */
export function BibleNav({ projectId, bookId }: NavProps) {
  const pathname = usePathname() || '';
  const base = `${bookBase(projectId, bookId)}/bible`;

  return (
    <nav
      aria-label="Book Bible sections"
      className="mb-8 flex items-center gap-5 overflow-x-auto border-b border-border/70"
    >
      {BIBLE_LINKS.map((link) => {
        const href = link.key
          ? link.key.startsWith('?')
            ? `${base}${link.key}`
            : `${base}/${link.key}`
          : base;
        const active = link.key
          ? link.key.startsWith('?')
            ? false
            : pathname.startsWith(href)
          : pathname === base || pathname === `${base}/`;
        return (
          <Link
            key={link.key || 'overview'}
            href={href}
            aria-current={active ? 'page' : undefined}
            className={`-mb-px whitespace-nowrap border-b-2 pb-2 text-xs uppercase tracking-wider transition-colors ${
              active
                ? 'border-foreground font-medium text-foreground'
                : 'border-transparent text-muted-foreground hover:text-foreground'
            }`}
          >
            {link.label}
          </Link>
        );
      })}
    </nav>
  );
}
