# =============================================================================
# AUTHORA Production Environment
# Copy to .env for production. NEVER commit .env to version control.
# =============================================================================

DEPLOYMENT_MODE=standalone

# Database - production PostgreSQL (Docker or managed)
DATABASE_URL=postgresql://authora:STRONG_PASSWORD@postgres:5432/authora
REDIS_URL=redis://redis:6379/0

# Auth - REQUIRED: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# Cron secret for /accountability/cron/reminders
CRON_SECRET=

# Frontend - production URLs (Option 2: marketing, app, api subdomains)
NEXT_PUBLIC_API_URL=https://api.authora.studio
NEXT_PUBLIC_MARKETING_URL=https://authora.studio
NEXT_PUBLIC_APP_URL=https://app.authora.studio
API_URL=https://api.authora.studio

# CORS - production origins
CORS_ORIGINS=["https://authora.studio","https://www.authora.studio","https://app.authora.studio"]

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Domains for Caddy (run ./scripts/generate-caddyfile.sh)
DOMAIN_API=api.authora.studio
DOMAIN_MARKETING=authora.studio
DOMAIN_APP=app.authora.studio
ACME_EMAIL=admin@authora.studio

# Stripe (optional - set FEATURE_BILLING=true to enable)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: separate webhook secrets for test vs live (STRIPE_WEBHOOK_SECRET takes precedence)
# STRIPE_WEBHOOK_SECRET_TEST=whsec_xxx
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_yyy
# STRIPE_LIVE_MODE=true
STRIPE_SUCCESS_URL=https://app.authora.studio/billing?success=1
STRIPE_CANCEL_URL=https://app.authora.studio/billing?canceled=1
