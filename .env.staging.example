# =============================================================================
# AUTHORA Staging Environment
# Copy to .env.staging or .env for staging deployment.
# =============================================================================

DEPLOYMENT_MODE=standalone

# Database - use staging DB (Docker or managed)
DATABASE_URL=postgresql://authora:CHANGE_ME@postgres:5432/authora
REDIS_URL=redis://redis:6379/0

# Auth - generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# Frontend - staging URLs
NEXT_PUBLIC_API_URL=https://api-staging.yourdomain.com
NEXT_PUBLIC_MARKETING_URL=https://staging.yourdomain.com
NEXT_PUBLIC_APP_URL=https://app-staging.yourdomain.com
API_URL=https://api-staging.yourdomain.com

# CORS - include staging origins
CORS_ORIGINS=["https://staging.yourdomain.com","https://app-staging.yourdomain.com"]

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Domains (for Caddy if used in staging)
# DOMAIN_API=api-staging.yourdomain.com
# DOMAIN_MARKETING=staging.yourdomain.com
# DOMAIN_APP=app-staging.yourdomain.com
# ACME_EMAIL=admin@yourdomain.com
