# AUTHORA Option 2 - authora.studio=marketing, app.authora.studio=app, api.authora.studio=API
# Run ./scripts/generate-caddyfile.sh to regenerate from .env

{
    email admin@authora.studio
}

api.authora.studio {
    reverse_proxy api:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}
    }
    encode gzip
}

authora.studio {
    reverse_proxy web:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}
    }
    encode gzip
}

app.authora.studio {
    reverse_proxy web:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}
    }
    encode gzip
}

www.authora.studio {
    redir https://authora.studio{uri} permanent
}
