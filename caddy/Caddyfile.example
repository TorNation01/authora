# AUTHORA Caddy - Option 2 domain architecture
# Run: ./scripts/generate-caddyfile.sh (uses DOMAIN_API, DOMAIN_MARKETING, DOMAIN_APP, ACME_EMAIL)

{
    email admin@authora.studio
}

api.authora.studio {
    reverse_proxy api:8000
    encode gzip
}

authora.studio {
    reverse_proxy web:3000
    encode gzip
}

app.authora.studio {
    reverse_proxy web:3000
    encode gzip
}

www.authora.studio {
    redir https://authora.studio{uri} permanent
}
