# AUTHORA Caddy Reverse Proxy - Example
# Copy to Caddyfile and replace domains/email.
# Or run: ./scripts/generate-caddyfile.sh (uses DOMAIN_API, DOMAIN_WEB, ACME_EMAIL from .env)

{
    email admin@yourdomain.com
}

api.yourdomain.com {
    reverse_proxy api:8000
    encode gzip
}

app.yourdomain.com {
    reverse_proxy web:3000
    encode gzip
}
